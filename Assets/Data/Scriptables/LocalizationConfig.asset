  - _key: ad_bonus.soft_money.result_description
    _values:
    - _language: ru
      _text: "\u041C\u043E\u043D\u0435\u0442\u044B \u0443\u0436\u0435 \u0437\u0430\u0447\u0438\u0441\u043B\u0435\u043D\u044B
